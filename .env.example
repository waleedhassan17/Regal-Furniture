# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: user management and scripts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Connect → Session pooler (URL-encode special characters in the password).
# Used only by npm scripts (migrations, types, seed checks). Not needed on Vercel.
DATABASE_URL=

# Optional alternative to registering in the app: `npm run create-admin`. Not needed on Vercel.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Optional but recommended in production: the one-time company registration asks for this code,
# so nobody else can register first. Share it only with the owner.
REGISTRATION_CODE=

# Optional: base URL for links shared on WhatsApp (e.g. https://orders.regalpk.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
